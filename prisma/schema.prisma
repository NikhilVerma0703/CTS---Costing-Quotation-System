// CTS Costing Tool. Two tables on purpose.
//
// A project is one JSON document holding only inputs (see src/lib/model.ts):
// pieces, variables, slab inputs, notes, hand-edited cells. Every calculated
// number comes from calculate() in src/lib/engine.ts, so nothing can go stale.

generator client {
  provider   = "prisma-client-js"
  // Rust-free client: queries run through the pg driver adapter (src/lib/db.ts).
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: DIRECT_URL is the non-pooled connection string. Locally it is the same.
  directUrl = env("DIRECT_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

/// The stored rate card, used when a project is started without a Variables sheet.
model StoredVariables {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}
