# ── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL (Windows service, no Docker) — put your postgres password
# in both lines. The database itself is created by `npx prisma db push`.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pacific_costing_quotation?schema=public"
# Neon: DATABASE_URL = pooled connection string, DIRECT_URL = direct one.
# Locally both are the same.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pacific_costing_quotation?schema=public"

# Sign-in is OFF for now. Changes are recorded in the audit log under this name.
APP_USER_NAME="Costing In-charge"

# Shown on the customer PDF header.
COMPANY_NAME="Pacific Surfaces"
COMPANY_ADDRESS=""
COMPANY_EMAIL="production@pacific-surfaces.com"
COMPANY_PHONE=""

APP_TIMEZONE="Asia/Kolkata"
