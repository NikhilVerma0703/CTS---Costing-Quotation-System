# Local PostgreSQL (Windows service, no Docker): put your postgres password in
# both lines. `npm run setup` creates the database.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pacific_costing_tool?schema=public"
# Neon: DATABASE_URL = pooled connection string, DIRECT_URL = direct one.
# Locally both are the same.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pacific_costing_tool?schema=public"

# Printed on the customer PDF.
COMPANY_NAME="Pacific Surfaces"
COMPANY_ADDRESS=""
COMPANY_EMAIL="production@pacific-surfaces.com"
COMPANY_PHONE=""

APP_TIMEZONE="Asia/Kolkata"
