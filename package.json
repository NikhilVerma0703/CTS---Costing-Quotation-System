{
  "name": "cts-costing-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Pacific Surfaces costing tool: upload a Drawing Summary, get Internal Costing, Customer Quote, Quote Summary, Slab Calculation and Project Summary with live recalculation.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "setup": "npm install && prisma db push && tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "4.3.0",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "lucide-react": "1.52.0",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.8",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.27",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
